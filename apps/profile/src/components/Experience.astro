---
import type { Resume } from '../content/schema';
interface Props { items: Resume['experience']; heading: string; labels: Resume['labels'] }
const { items, heading, labels } = Astro.props;
---
<section id="experience" class="section container">
  <h2>{heading}</h2>
  {items.map((e) => (
    <article class="entry">
      <div class="row">
        <h3>{e.company} <span class="role">— {e.role}</span></h3>
        <span class="meta">{e.period} · {e.location}</span>
      </div>
      {e.intro && <p class="intro">{e.intro}</p>}
      {e.groups?.map((g) => (
        <details class="group fold" data-fold>
          <summary>
            <h4>{g.name}</h4>
            <span class="lead">{g.lead}</span>
            <span class="hint" aria-hidden="true">{labels.details}</span>
          </summary>
          <ul>{g.bullets.map((b) => <li>{b}</li>)}</ul>
        </details>
      ))}
      {e.bullets.length > 0 && (e.lead ? (
        <details class="fold" data-fold>
          <summary>
            <span class="lead">{e.lead}</span>
            <span class="hint" aria-hidden="true">{labels.details}</span>
          </summary>
          <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
        </details>
      ) : (
        <ul>{e.bullets.map((b) => <li>{b}</li>)}</ul>
      ))}
      <ul class="tags" role="list">{e.stack.map((s) => <li class="tag" role="listitem">{s}</li>)}</ul>
    </article>
  ))}
</section>
<style>
  .role { font-weight: 400; color: var(--fg-muted); }
  .intro { color: var(--fg-muted); margin-top: .3em; }
  .tags { list-style: none; padding: 0; }
</style>
