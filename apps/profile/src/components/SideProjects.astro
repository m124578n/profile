---
import type { Resume } from '../content/schema';
interface Props { items: Resume['sideProjects']; heading: string; labels: Resume['labels'] }
const { items, heading, labels } = Astro.props;
---
<section id="side-projects" class="section container">
  <h2>{heading}</h2>
  {items.map((p) => (
    <article class="entry">
      <div class="row"><h3>{p.name}</h3>{p.period && <span class="meta">{p.period}</span>}</div>
      <details class="fold" data-fold>
        <summary>
          <span class="lead">{p.lead}</span>
          <span class="hint" aria-hidden="true">{labels.details}</span>
        </summary>
        <p>{p.desc}</p>
      </details>
      {p.links.length > 0 && <p class="links">{p.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">↗</span></a>)}</p>}
    </article>
  ))}
</section>
<style>
  .entry + .entry { margin-top: var(--space-4); padding-top: var(--space-3); }
  .links { display: flex; gap: var(--space-3); margin-top: .4em; }
</style>
