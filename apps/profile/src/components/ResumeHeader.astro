---
import type { Resume } from '../content/schema';
import type { Locale } from '@shunzz/ui/i18n';
interface Props { header: Resume['header']; labels: Resume['labels']; locale: Locale }
const { header, labels, locale } = Astro.props;
---
<header class="container resume-header">
  <div class="row">
    <div>
      <h1>{header.name}</h1>
      <p class="latin" lang={locale === 'en' ? 'zh-Hant' : 'en'}>{header.latinName}</p>
    </div>
    <div class="actions no-print">
      <button type="button" class="btn ghost" data-fold-all="open">{labels.expandAll}</button>
      <button type="button" class="btn ghost" data-fold-all="close">{labels.collapseAll}</button>
      <button type="button" class="btn print-btn" data-print>{labels.print}</button>
    </div>
  </div>
  <p class="title">{header.title} · <span class="meta">{header.location}</span></p>
  <ul class="contacts" role="list">
    {header.contacts.map((c) => <li role="listitem"><a href={c.href} rel={c.rel}>{c.label}</a></li>)}
  </ul>
  <p class="summary">{header.summary}</p>
</header>
<style>
  .resume-header { padding-block: var(--space-5) var(--space-3); }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin-bottom: 0; }
  .latin { font-family: var(--font-mono); color: var(--fg-muted); margin: 0; }
  .title { font-weight: 600; margin-top: var(--space-2); }
  .contacts { list-style: none; padding: 0; margin: 0 0 var(--space-3); display: flex; flex-wrap: wrap; gap: .4em 1.2em; font-size: .95rem; }
  .summary { font-size: 1.02rem; }
  .actions { display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; }
  .btn.ghost { background: transparent; color: var(--fg-muted); border: 1px solid var(--line); }
  .btn.ghost:hover { color: var(--fg); border-color: var(--fg-muted); }
</style>
<script>
  const folds = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-fold]'));
  const setAll = (open: boolean) => folds().forEach((d) => { d.open = open; });

  document.querySelectorAll<HTMLButtonElement>('[data-fold-all]').forEach((b) =>
    b.addEventListener('click', () => setAll(b.dataset.foldAll === 'open')));
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));

  // 列印/存 PDF 時一律展開全部,印完還原原本的開合狀態
  let saved: boolean[] = [];
  window.addEventListener('beforeprint', () => { saved = folds().map((d) => d.open); setAll(true); });
  window.addEventListener('afterprint', () => { folds().forEach((d, i) => { d.open = saved[i] ?? false; }); });
</script>
